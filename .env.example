# Copiar a .env (no se versiona). Solo desarrollo local: debe coincidir con la
# connection string de src/Web.Api/appsettings.Development.json para `dotnet run`.
POSTGRES_PASSWORD=postgres
# Firma de los JWT de la API en Docker (/run/secrets/Jwt__Secret). Mínimo 32 caracteres; en un
# despliegue real, uno aleatorio: openssl rand -base64 48
JWT_SECRET=solo-para-desarrollo-local-cambiar-en-despliegue-0123456789
