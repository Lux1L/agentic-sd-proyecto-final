{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=arriendo-familiar;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "ArriendoFamiliar.Api"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Seed": { "Enabled": true },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 2000,
      "WindowInSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "arriendo-familiar",
    "Audience": "arriendo-familiar-web",
    "ExpirationInMinutes": 60
  }
}
